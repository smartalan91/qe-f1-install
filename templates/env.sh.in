# Quantum ESPRESSO @QE_VERSION@ (@TOOLCHAIN@) — environment file
# Usage:  source @PREFIX@/env.sh
# Generated by qe-f1-install on @DATE@ ; do not edit, re-run install.sh instead.

if ! type module >/dev/null 2>&1; then [ -r /etc/profile.d/modules.sh ] && . /etc/profile.d/modules.sh; fi
@MODULE_LOAD_LINES@

export QE_ROOT="@PREFIX@"
export PATH="$QE_ROOT/bin${PATH:+:$PATH}"
# QE looks here for pseudopotentials when pseudo_dir is not given in the input
export ESPRESSO_PSEUDO="${ESPRESSO_PSEUDO:-$QE_ROOT/share/qe-f1-install/pseudo}"
# Pure-MPI build: keep OpenMP threads at 1 unless you built with --openmp on
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-@OMP_DEFAULT@}"
