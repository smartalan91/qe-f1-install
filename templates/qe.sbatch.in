#!/bin/bash
#SBATCH --job-name=qe-pw
#SBATCH --account=@ACCOUNT@          # your project code (see `sacctmgr show assoc user=$USER`)
#SBATCH --partition=ct112            # 1-112 cores; use ct448/ct1k... for more nodes
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=56         # 2 x 56-core Xeon 8480+ per node; 56 = one socket
#SBATCH --cpus-per-task=1
#SBATCH --time=01:00:00
#SBATCH --output=%x-%j.out
# Example SLURM job for Quantum ESPRESSO @QE_VERSION@ (@TOOLCHAIN@) installed by qe-f1-install.
# Edit the input file name below, then:  sbatch qe.sbatch

set -euo pipefail
source "@PREFIX@/env.sh"
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}

INPUT=${1:-pw.in}
@MPIRUN_LINE@
