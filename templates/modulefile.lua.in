-- Quantum ESPRESSO @QE_VERSION@ (@TOOLCHAIN@) — Lmod modulefile generated by qe-f1-install on @DATE@
-- Usage:  module use @PREFIX@/modulefiles && module load qe/@QE_VERSION@-@TOOLCHAIN@
help([[Quantum ESPRESSO @QE_VERSION@ built from source on NCHC Forerunner 1 (創進一號)
with the @TOOLCHAIN@ toolchain (@TOOLCHAIN_DESC@).
Executables: pw.x, ph.x, pp.x, projwfc.x, dos.x, bands.x, cp.x, neb.x, wannier90.x, ...
Build record: @PREFIX@/BUILDINFO.json]])
whatis("Name: Quantum ESPRESSO")
whatis("Version: @QE_VERSION@")
whatis("Toolchain: @TOOLCHAIN_DESC@")

@MODULE_DEPENDS_LINES@

local root = "@PREFIX@"
setenv("QE_ROOT", root)
prepend_path("PATH", pathJoin(root, "bin"))
setenv("ESPRESSO_PSEUDO", pathJoin(root, "share/qe-f1-install/pseudo"))
if (os.getenv("OMP_NUM_THREADS") == nil) then setenv("OMP_NUM_THREADS", "@OMP_DEFAULT@") end
